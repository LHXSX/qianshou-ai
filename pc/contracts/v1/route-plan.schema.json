{
  "title": "qianshou/route-plan/v1",
  "description": "A quoted routing decision before a lease. It records hard filtering, scoring, selected offers, privacy, fallbacks and an explanation.",
  "type": "object",
  "properties": {
    "contract": { "type": "string", "const": "qianshou/route-plan/v1" },
    "route_id": { "type": "string" },
    "intent_id": { "type": "string" },
    "revision": { "type": "integer" },
    "status": { "type": "string", "enum": ["draft", "quoted", "accepted", "expired", "rejected"] },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": { "type": "string" },
          "capability_id": { "type": "string" },
          "capability_version": { "type": "string" },
          "input_refs": { "type": "array", "items": { "type": "string" } },
          "output_kind": { "type": "string" },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "offer_id": { "type": "string" },
                "node_id": { "type": "string" },
                "score": { "type": "number" },
                "eligible": { "type": "boolean" },
                "reason_codes": { "type": "array", "items": { "type": "string" } }
              },
              "required": ["offer_id", "node_id", "score", "eligible", "reason_codes"],
              "additionalProperties": false
            }
          },
          "selected": {
            "type": "object",
            "properties": {
              "offer_id": { "type": "string" },
              "node_id": { "type": "string" },
              "manifest_revision": { "type": "integer" }
            },
            "required": ["offer_id", "node_id", "manifest_revision"],
            "additionalProperties": false
          },
          "privacy": {
            "type": "object",
            "properties": {
              "data_residency": { "type": "string", "enum": ["local", "region", "any"] },
              "network_egress": { "type": "string", "enum": ["denied", "declared", "allowed"] }
            },
            "required": ["data_residency", "network_egress"],
            "additionalProperties": false
          },
          "fallback_offer_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["step_id", "capability_id", "capability_version", "input_refs", "output_kind", "candidates", "selected", "privacy", "fallback_offer_ids"],
        "additionalProperties": false
      }
    },
    "quote": {
      "type": "object",
      "properties": {
        "amount_minor": { "type": "integer" },
        "currency": { "type": "string" },
        "unit": { "type": "string" },
        "expires_at": { "type": "string" }
      },
      "required": ["amount_minor", "currency", "unit", "expires_at"],
      "additionalProperties": false
    },
    "explanation": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["contract", "route_id", "intent_id", "revision", "status", "steps", "quote", "explanation"],
  "additionalProperties": false
}
