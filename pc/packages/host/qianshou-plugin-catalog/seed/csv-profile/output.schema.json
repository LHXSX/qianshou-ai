{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSV 结构体检结果",
  "type": "object",
  "additionalProperties": false,
  "required": ["rowCount", "columnCount", "delimiter", "columns", "sampleRows"],
  "properties": {
    "rowCount": { "type": "integer", "minimum": 0 },
    "columnCount": { "type": "integer", "minimum": 1, "maximum": 64 },
    "delimiter": { "enum": [",", ";", "\t"] },
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "name", "nonEmptyCount", "emptyCount", "kind"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "name": { "type": "string" },
          "nonEmptyCount": { "type": "integer", "minimum": 0 },
          "emptyCount": { "type": "integer", "minimum": 0 },
          "kind": { "enum": ["empty", "number", "text", "mixed"] }
        }
      }
    },
    "sampleRows": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "array",
        "maxItems": 64,
        "items": { "type": "string" }
      }
    }
  }
}
