{
  "name": "@deepseek-ai/dsh-host-plugin-lifecycle",
  "description": "Transactional local lifecycle for verified Qianshou capability plugins",
  "version": "0.1.5-rc.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
