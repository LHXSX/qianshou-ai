{
  "name": "@deepseek-ai/dsh-host-account-session",
  "version": "0.1.5-rc.2",
  "description": "Host-side Qianshou account session: file-backed tokens shared by the PC UI and the compute node",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./plugin": {
      "types": "./lib/types/plugin-entry.d.ts",
      "default": "./lib/plugin.js"
    }
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "files": [
    "lib/index.js",
    "lib/plugin.js",
    "lib/types/**/*.d.ts"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-client-account": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^"
  }
}
