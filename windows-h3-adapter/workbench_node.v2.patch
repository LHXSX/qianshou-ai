+def attested_request_v2(body):
+    """Admit V2 only on the explicit new route; retain V1 payload validation."""
+    if not isinstance(body, dict):
+        raise ValueError("Object required")
+    expected = body.get("expected")
+    fields = {"schemaVersion", "executionRecipeSha256", "modelSha256",
+              "firstFrameSha256", "localConfigSha256"}
+    if (not isinstance(expected, dict) or set(expected) != fields
+            or expected["schemaVersion"] != "qs.h3.execution-expected.v2"
+            or any(not isinstance(expected[key], str) or not _SHA256.fullmatch(expected[key])
+                   for key in fields - {"schemaVersion"})):
+        raise ValueError("H3_V2_EXPECTED_IDENTITY_INVALID")
+    legacy = {**body, "expected": {key: expected[key] for key in
+                                  ("executionRecipeSha256", "modelSha256")}}
+    attested = validate_payload(legacy)
+    if attested is None or attested["firstFrameSha256"] != expected["firstFrameSha256"]:
+        raise ValueError("H3_V2_FIRST_FRAME_IDENTITY_MISMATCH")
+    return legacy, {**attested, "schemaVersion": "qs.h3.job-identity.v2", "expected": dict(expected)}
+
+
+def identity_keys(attested):
+    return (("executionRecipeSha256", "modelSha256", "firstFrameSha256", "localConfigSha256")
+            if attested.get("schemaVersion") == "qs.h3.job-identity.v2"
+            else ("executionRecipeSha256", "modelSha256"))
 
 
