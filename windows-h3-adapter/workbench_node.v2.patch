+    def first_frame_v2(job, attested):
+        input_root = (root / "input").resolve(strict=True)
+        relative = job.get("first_frame_rel")
+        if not isinstance(relative, str) or not relative:
+            raise RecipeIdentityError("V2 first frame is unavailable")
+        requested = input_root / relative
+        first_path = requested.resolve(strict=True)
+        if requested.is_symlink() or not first_path.is_relative_to(input_root) or not first_path.is_file():
+            raise RecipeIdentityError("V2 first frame escaped Comfy input")
+        before = first_path.stat()
+        if not 8 < before.st_size <= 16 * 1024 * 1024:
+            raise RecipeIdentityError("V2 first frame is invalid")
+        with first_path.open("rb") as stream:
+            opened = os.fstat(stream.fileno())
+            data = stream.read(16 * 1024 * 1024 + 1)
+            finished = os.fstat(stream.fileno())
+        after = first_path.stat()
+        fact = lambda st: (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns, st.st_ctime_ns)
+        digest = hashlib.sha256(data).hexdigest()
+        if (len(data) != before.st_size or fact(before) != fact(opened)
+                or fact(opened) != fact(finished) or fact(finished) != fact(after)
+                or requested.resolve(strict=True) != first_path or not data.startswith(b"\x89PNG\r\n\x1a\n")
+                or digest != attested["firstFrameSha256"]):
+            raise RecipeIdentityError("V2 first frame changed during execution")
+        return digest
